{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node", "jest"],
    "esModuleInterop": true,
    "paths": {
      "@nasna/shared": ["../shared/src/index.ts"]
    }
  },
  "compileOnSave": true,
  "include": ["src"]
}
