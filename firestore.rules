rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function authProfile() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn()
        && (
          request.auth.token.role == 'super_admin'
          || request.auth.token.role == 'admin'
          || authProfile().isAdmin == true
          || authProfile().role == 'super_admin'
          || authProfile().role == 'admin'
        );
    }

    function isSuperAdmin() {
      return isSignedIn()
        && (
          request.auth.token.role == 'super_admin'
          || authProfile().role == 'super_admin'
        );
    }

    function isAgent() {
      return isSignedIn()
        && (
          request.auth.token.role == 'agent'
          || authProfile().role == 'agent'
        );
    }

    function isMember() {
      return isSignedIn()
        && (
          request.auth.token.role == 'member'
          || authProfile().role == 'member'
        );
    }

    function isValidatedMember() {
      return isMember()
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.validated == true;
    }

    // Ensure incoming data only contains the allowed set of keys
    function onlyFields(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    // Prevent fields from being changed in an update
    function fieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function hasField(field) {
      return request.resource.data.keys().hasAny([field]);
    }

    // ─── /members ───────────────────────────────────────────────────────────

    match /members/{userId} {
      allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin();

      // Registration: only allowed fields, role must not be 'admin'
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role in ['member', 'agent']
        && onlyFields(['uid', 'name', 'contactPersonName', 'email', 'phoneNumber', 'role',
                       'validated', 'onboarded', 'createdAt', 'updatedAt', 'consentGiven',
                       'areaOfOperation', 'kindOfHelp', 'initiativeOrNgo',
                       'numberOfVolunteers', 'isOfficiallyRegistered', 'isAdmin',
                       'coverageType', 'coverageGovernorates', 'coverageCenterIds',
                       'aidTypes', 'currentCaseLoad', 'maxCaseLoad', 'deliveryMode'])
        && request.resource.data.validated == false
        && (!hasField('coverageType') || request.resource.data.coverageType in ['governorate', 'center', 'hybrid'])
        && (!hasField('deliveryMode') || request.resource.data.deliveryMode in ['delivery', 'pickup', 'both'])
        && (!hasField('coverageGovernorates') || request.resource.data.coverageGovernorates is list)
        && (!hasField('coverageCenterIds') || request.resource.data.coverageCenterIds is list)
        && (!hasField('aidTypes') || request.resource.data.aidTypes is list)
        && (!hasField('currentCaseLoad') || request.resource.data.currentCaseLoad is int)
        && (!hasField('maxCaseLoad') || request.resource.data.maxCaseLoad is int); // cannot self-validate on create

      // Users cannot change their own role or validated status — admin only
      allow update: if isAdmin()
        && onlyFields(['name', 'contactPersonName', 'email', 'phoneNumber',
                       'validated', 'updatedAt', 'coverageType', 'coverageGovernorates',
                       'coverageCenterIds', 'aidTypes', 'currentCaseLoad',
                       'maxCaseLoad', 'deliveryMode']);

      allow delete: if isAdmin();
    }

    // ─── /feedback ───────────────────────────────────────────────────────────

    match /feedback/{docId} {
      allow create: if onlyFields(['type', 'name', 'email', 'message', 'read', 'createdAt'])
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.read == false;
      allow read, update, delete: if isAdmin();
    }

    // ─── /offers ─────────────────────────────────────────────────────────────

    match /offers/{docId} {
      allow create: if onlyFields(['type', 'phone', 'region', 'lat', 'lng',
                                   'neighborhood', 'capacity', 'description', 'createdAt']);
      allow read, update, delete: if isAdmin();
    }

    // ─── /centers ───────────────────────────────────────────────────────────

    match /centers/{centerId} {
      // Active centers are readable by anyone (unauthenticated public intake).
      // Admins can read all centers including inactive ones.
      // NOTE: field is `active` (not `isActive`) — matches the data written by CenterManagement.
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
      // Agents may update only occupancy/intake fields on their assigned center.
      allow update: if isAgent()
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.centerId == centerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentOccupancy', 'intakeOpen', 'updatedAt']);
    }

    // ─── /housing ───────────────────────────────────────────────────────────

    match /housing/{housingId} {
      // Public submission: unauthenticated allowed, but must arrive as pending_review
      // with only the expected fields — prevents bypassing the moderation queue.
      allow create: if onlyFields([
                       'listerId', 'listerName', 'listerPhone', 'type', 'governorate',
                       'district', 'capacity', 'priceType', 'pricePerMonth',
                       'availableFrom', 'availableUntil', 'amenities', 'description',
                       'status', 'createdAt', 'updatedAt'])
        && request.resource.data.status == 'pending_review'
        && request.resource.data.listerName is string
        && request.resource.data.listerPhone is string
        && request.resource.data.capacity is int
        && request.resource.data.capacity > 0
        && request.resource.data.priceType in ['free', 'subsidized', 'market_rate'];
      // `approved` is the post-moderation status set by admins; `available` is the
      // live-listed status. Both are safe for public read on the centers map.
      allow read: if isAdmin()
        || resource.data.status == 'available'
        || resource.data.status == 'approved';
      allow update, delete: if isAdmin();
    }

    // ─── /emergencyContacts ─────────────────────────────────────────────────

    match /emergencyContacts/{contactId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── /notifications ─────────────────────────────────────────────────────

    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.recipientUid == request.auth.uid);
      allow write: if isAdmin();
    }

    match /platformSettings/{settingsId} {
      allow read, write: if isSuperAdmin();
    }

    // ─── /stats ─────────────────────────────────────────────────────────────

    match /stats/{statsId} {
      allow read: if statsId == 'global';
      allow write: if isAdmin();
    }

    // ─── /stats/global/snapshots ────────────────────────────────────────────────
    // Public read — all users including unauthenticated may read snapshot history.
    // Writes are Cloud Functions only via Admin SDK (bypasses these rules).

    match /stats/global/snapshots/{date} {
      allow read: if true;
      allow write: if false;
    }

    // ─── /businesses ─────────────────────────────────────────────────────────

    match /businesses/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── /requests ───────────────────────────────────────────────────────────

    match /requests/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── /donations ──────────────────────────────────────────────────────────

    match /donations/{donationId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // ─── /auditLog ───────────────────────────────────────────────────────────
    // Written exclusively by Cloud Functions (Admin SDK bypasses these rules).
    // Admins can read; no client may write.

    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── /wa_sessions ──────────────────────────────────────────────────────────

    match /wa_sessions/{phone} {
      allow read, write: if false;
      // This collection is managed exclusively by Cloud Functions service account.
      // No client — authenticated or not — may read or write to this collection.
    }

    // ─── /submissions ────────────────────────────────────────────────────────
    // NOTE: whatsappPhone is not readable by members. Firestore rules cannot
    // mask individual fields, so Cloud Functions must strip whatsappPhone
    // before returning submission data to member-facing queries.

    match /submissions/{submissionId} {
      // Validate all fields on create — prevents garbage data injection
      allow create: if onlyFields([
          'fullName', 'phoneNumber', 'emailAddress', 'gender',
          'currentGovernorate', 'previousGovernorate', 'street', 'building',
          'floor', 'city', 'ageRanges', 'specialNeeds', 'needs', 'aidUrgency',
          'consentGiven', 'comments', 'numberOfPeopleInHousehold',
          'registrationDate', 'createdAt', 'updatedAt', 'agent', 'status',
          'locationType', 'centerId', 'assignedTo', 'assignedAt', 'aidDelivered',
          'aidDeliveries', 'lastUpdatedBy', 'staleFlagged', 'source'
        ])
        && request.resource.data.consentGiven == true  // consent is mandatory
        && request.resource.data.aidUrgency in ['High', 'Medium', 'Low']
        && request.resource.data.gender in ['Male', 'Female', '']
        && (!hasField('status') || request.resource.data.status in ['pending', 'assigned', 'in_progress', 'completed', 'cancelled'])
        && (!hasField('locationType') || request.resource.data.locationType in ['with_family', 'center'])
        && (!hasField('source') || request.resource.data.source in ['web', 'agent', 'admin', 'migration'])
        && (!hasField('centerId') || request.resource.data.centerId is string)
        && (!hasField('assignedTo') || request.resource.data.assignedTo is string)
        && (!hasField('assignedAt') || request.resource.data.assignedAt == null || request.resource.data.assignedAt is timestamp)
        && (!hasField('aidDelivered') || request.resource.data.aidDelivered is bool)
        && (!hasField('aidDeliveries') || request.resource.data.aidDeliveries is list)
        && (!hasField('lastUpdatedBy') || request.resource.data.lastUpdatedBy is string)
        && (!hasField('staleFlagged') || request.resource.data.staleFlagged is bool);

      // Duplicate-phone check moved to Cloud Function — no unauthenticated reads
      allow read: if isAdmin()
        || (isAgent() && resource.data.agent == request.auth.uid)
        || (isAgent()
            && resource.data.centerId != null
            && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.centerId == resource.data.centerId);

      // Only admins may edit; prevent changing the core submission fields
      allow update: if isAdmin()
        && fieldsUnchanged(['fullName', 'phoneNumber', 'emailAddress', 'agent',
                            'createdAt', 'registrationDate']);

      allow delete: if isAdmin();
    }

  }
}
